<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UTLauncher.App.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:logging="using:UTLauncher.Core.Logging"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="UTLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="UT Launcher"
        Width="960" Height="640">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="F12" Command="{Binding ToggleConsoleCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemBaseLowColor}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="UT Launcher" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="System check" Command="{Binding ToggleDoctorCommand}" />
                    <Button Content="Console (F12)" Command="{Binding ToggleConsoleCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0">
                <StackPanel Margin="16" Spacing="12">
                    <Border Background="#33FF3333"
                            Padding="12"
                            CornerRadius="6"
                            IsVisible="{Binding StartupError, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding StartupError}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="#332B7CD3"
                            Padding="12"
                            CornerRadius="6"
                            IsVisible="{Binding AvailableUpdateVersion, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap">
                                <Run Text="A new launcher version (" />
                                <Run Text="{Binding AvailableUpdateVersion}" FontWeight="Bold" />
                                <Run Text=") is available." />
                            </TextBlock>
                            <Button DockPanel.Dock="Right"
                                    Content="Open download page"
                                    HorizontalAlignment="Right"
                                    Command="{Binding OpenReleasesPageCommand}" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GameViewModel">
                                <Border Padding="16"
                                        Margin="0,0,0,12"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemBaseLowColor}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                                <TextBlock Text="{Binding StatusText}" Opacity="0.8" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding InstallButtonLabel}"
                                                        Command="{Binding InstallCommand}"
                                                        IsVisible="{Binding ShowInstallButton}" />
                                                <Button Content="Cancel"
                                                        Command="{Binding CancelInstallCommand}"
                                                        IsVisible="{Binding IsBusy}" />
                                                <Button Content="Play"
                                                        Command="{Binding LaunchCommand}"
                                                        IsVisible="{Binding IsInstalled}" />
                                                <Button Content="Open folder"
                                                        Command="{Binding OpenFolderCommand}"
                                                        IsVisible="{Binding IsInstalled}" />
                                                <Button Content="Register account"
                                                        Command="{Binding OpenRegistrationCommand}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                            <Binding Path="IsInstalled" />
                                                            <Binding Path="HasAccountRegistration" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>
                                                <Button Content="&#9881;"
                                                        ToolTip.Tip="Game settings"
                                                        IsVisible="{Binding IsInstalled}">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="Use WASD movement"
                                                                      Command="{Binding ApplyWasdMovementCommand}"
                                                                      IsVisible="{Binding HasWasdFix}" />
                                                            <Separator IsVisible="{Binding HasWasdFix}" />
                                                            <MenuItem Header="Uninstall..."
                                                                      Command="{Binding RequestUninstallCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                                            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                                                         Value="{Binding ProgressPercent}"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Height="6" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Opacity="0.7" />
                                        </StackPanel>

                                        <Border Background="#33FF3333"
                                                Padding="10"
                                                CornerRadius="6"
                                                IsVisible="{Binding IsConfirmingUninstall}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="Delete this installation and all its files? This cannot be undone."
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            HorizontalAlignment="Right">
                                                    <Button Content="Cancel" Command="{Binding CancelUninstallCommand}" />
                                                    <Button Content="Delete" Command="{Binding UninstallCommand}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <TextBlock Text="{Binding InstallPath}" FontSize="11" Opacity="0.5" />
                                        <TextBlock Text="{Binding SettingsFeedback}"
                                                   FontSize="11"
                                                   Opacity="0.8"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding SettingsFeedback, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Width="320"
                    IsVisible="{Binding IsDoctorVisible}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource SystemBaseLowColor}">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="System check" FontWeight="Bold" Margin="0,0,0,8" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Doctor.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding Hint}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   FontFamily="Consolas,monospace"
                                                   IsVisible="{Binding Hint, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                IsVisible="{Binding IsConsoleVisible}"
                Height="260"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemBaseLowColor}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="{DynamicResource SystemBaseLowColor}"
                        Padding="12,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Console"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CopyLogsFeedback}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding CopyLogsFeedback, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            <Button Content="Copy" Command="{Binding CopyLogsCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" FontFamily="Consolas,monospace" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="logging:LogEntry">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Opacity="0.6" Width="70" />
                                <TextBlock Text="{Binding Level}" FontWeight="Bold" Width="90" />
                                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>

</Window>
